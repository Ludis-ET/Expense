// Santim data model - personal finance.
// Privacy model: every row is owned by exactly one User via userId (directly
// or via its parent). Services always filter by the authenticated user's id.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // native = local/CI; debian + rhel cover most cPanel / CloudLinux hosts
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TxKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  MOBILE_MONEY
  CARD
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// The step a recurring plan advances by. Paired with an interval, this spells
// out any cadence the user wants: every 6 HOURs, every 3 DAYs, every 2 WEEKs...
enum RecurrenceUnit {
  HOUR
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

// A plan runs once until its money is gone, renews on a cadence, or is the
// single built-in UNPLANNED plan that catches spending you never reserved for.
enum BudgetKind {
  ONE_TIME
  RECURRING
  UNPLANNED
}

enum BudgetState {
  ACTIVE
  CLOSED
}

// Money moving between an account and a plan's pot. FUND is positive (account
// -> plan), RELEASE is negative (plan -> account). Spending is not an
// allocation: it is a Transaction carrying budgetId.
enum BudgetAllocationKind {
  FUND
  RELEASE
}

enum HouseholdRole {
  OWNER
  PARTNER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Personal IOUs: money lent/borrowed, and one-off income you're still waiting on.
enum LedgerKind {
  LENT         // you gave money - they owe you
  BORROWED     // you borrowed - you owe them
  EXPECTED_IN  // income coming (not on a recurring schedule)
  EXPECTED_OUT // one-off bill/commitment coming (not recurring)
}

enum LedgerStatus {
  OPEN
  SETTLED
  CANCELLED
}

// A want moves WANTING -> PLANNED once it has a budget plan behind it.
enum WishlistStatus {
  WANTING
  PLANNED
  BOUGHT
  DROPPED
}

// Where a captured message came from. SMS is the Android companion app; the
// others are here so the inbox pipeline stays channel-agnostic.
enum MessageSource {
  SMS
  NOTIFICATION
  MANUAL
  EMAIL
}

// Lifecycle of a captured bank message.
//   PENDING   - parsed, waiting for the user to confirm it
//   CONFIRMED - a real Transaction was created from it
//   REJECTED  - user dismissed it; kept so it is never re-ingested
//   UNPARSED  - no parser understood it; visible so patterns can be improved
//   DUPLICATE - matched an earlier message's bank reference
enum InboxStatus {
  PENDING
  CONFIRMED
  REJECTED
  UNPARSED
  DUPLICATE
}

model User {
  id             String @id @default(cuid())
  email          String @unique
  passwordHash   String
  name           String
  locale         String @default("en")
  calendar       String @default("gregorian") // "gregorian" | "ethiopian" - display preference
  currency       String @default("ETB") // default display/entry currency
  firstDayOfWeek Int    @default(1) // 1 = Monday, 0 = Sunday
  /// Preset illustration id from the avatar catalog (assigned randomly on signup).
  avatarId       String
  /// Preset settings-banner id from the banner catalog (assigned randomly on signup).
  bannerId       String
  /// Which wallet holds physical cash. ATM withdrawals are booked as a
  /// transfer into it rather than as spending, so the money is not counted as
  /// gone until it is actually spent. The user nominates this - there is no
  /// safe way to guess which of their wallets is the cash one.
  cashAccountId  String?

  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  recurringRules    RecurringRule[]
  budgets           Budget[]
  budgetAllocations BudgetAllocation[]
  budgetAdjustments BudgetAdjustment[]
  notifications     Notification[]
  aiSetting         AiSetting?
  householdMembers  HouseholdMember[]
  sentInvites       HouseholdInvite[] @relation("InviteSender")
  ledgerEntries     LedgerEntry[]
  exchangeRates     ExchangeRate[]
  wishlistItems     WishlistItem[]
  weekSnapshots     WeekSnapshot[]
  devices           Device[]
  inboxMessages     InboxMessage[]
  senderRules       BankSenderRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Household {
  id      String @id @default(cuid())
  name    String @default("Our Household")

  members  HouseholdMember[]
  invites  HouseholdInvite[]
  accounts Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(PARTNER)
  joinedAt    DateTime      @default(now())

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model HouseholdInvite {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String
  token       String       @unique @default(cuid())
  invitedById String
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  @@index([email, status])
  @@map("household_invites")
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId    String?
  household      Household?  @relation(fields: [householdId], references: [id], onDelete: SetNull)
  isShared       Boolean     @default(false) // visible to all household members
  name           String // "Cash", "CBE", "Telebirr"
  type           AccountType @default(CASH)
  currency       String      @default("ETB")
  /// Account number as the bank writes it, usually masked ("****4821"). Used
  /// to recognise which of your own wallets a transfer message refers to, so
  /// an inter-account move is offered as a transfer rather than as spending.
  accountNumber  String?
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  icon           String? // lucide icon name
  color          String? // hex
  isDefault      Boolean     @default(false)
  archived       Boolean     @default(false)

  transactions   Transaction[]      @relation("TxAccount")
  transfersIn    Transaction[]      @relation("TxTransferAccount")
  planSpends     Transaction[]      @relation("TxBudgetSourceAccount")
  recurringRules RecurringRule[]
  allocations    BudgetAllocation[]
  senderRules    BankSenderRule[]
  inboxMessages  InboxMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([householdId])
  @@index([userId, accountNumber])
  @@map("accounts")
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      CategoryKind
  icon      String       @default("circle") // lucide icon name
  color     String       @default("#64748b")
  isDefault Boolean      @default(false) // seeded at registration
  archived  Boolean      @default(false)

  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]
  ledgerEntries  LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, kind])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind     TxKind
  amount   Decimal  @db.Decimal(14, 2) // always positive; kind carries the sign
  currency String   @default("ETB")
  date     DateTime

  accountId         String
  account           Account   @relation("TxAccount", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccountId String? // destination account, TRANSFER only
  transferAccount   Account?  @relation("TxTransferAccount", fields: [transferAccountId], references: [id], onDelete: SetNull)
  categoryId        String? // null for transfers
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Paid out of a budget plan's pot instead of straight from the account. The
  // money was already reserved when the plan was funded, so the spend releases
  // that reservation and takes the real balance down at the same time.
  budgetId    String?
  budget      Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  budgetCycle Int? // which cycle of a recurring plan this belongs to

  // Which funding account's reservation this plan expense frees. Usually the
  // same as accountId, but not always: you can fill a plan from one wallet and
  // pay from another, and the reservation still has to come off the wallet that
  // was actually holding it. Reservation aggregates group by this, never by
  // accountId. Null for anything that is not a funded-plan expense.
  budgetSourceAccountId String?
  budgetSourceAccount   Account? @relation("TxBudgetSourceAccount", fields: [budgetSourceAccountId], references: [id], onDelete: SetNull)

  note            String?
  payee           String? // merchant / person
  tags            String[]       @default([])
  receiptUrl      String?
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  // Set when this row was created from a captured bank message rather than
  // typed by hand. Deleting the transaction releases the message back to the
  // inbox instead of orphaning it.
  inboxMessage InboxMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, kind])
  @@index([accountId])
  @@index([budgetId, budgetCycle])
  @@index([budgetSourceAccountId])
  @@map("transactions")
}

model RecurringRule {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // "Salary", "Rent", "Netflix"
  kind       TxKind // INCOME or EXPENSE (no recurring transfers, v1)
  amount     Decimal   @db.Decimal(14, 2)
  currency   String    @default("ETB")
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payee      String?
  note       String?

  frequency  Frequency
  interval   Int       @default(1) // every N periods
  dayOfMonth Int? // MONTHLY: clamp 29–31 to month end
  nextRun    DateTime
  endDate    DateTime?
  autoPost   Boolean   @default(true) // false = remind-only notification
  active     Boolean   @default(true)
  lastRunAt  DateTime?

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active, nextRun])
  @@map("recurring_rules")
}

// A spending plan (envelope). Named by the user - a category is optional
// metadata that pre-selects itself when you spend from the plan.
//
// A plan starts empty. You fill it from accounts (BudgetAllocation), which
// reserves that money: it stays physically in the account but no longer counts
// as available. Spending against the plan writes a Transaction carrying
// budgetId, which takes the real balance down and frees the reservation.
//
// Live pot balance = SUM(allocations) - SUM(plan expenses). plannedAmount caps
// how much you may put in during one cycle.
model Budget {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  categoryId     String? // optional hint, auto-selected when spending
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  kind           BudgetKind   @default(ONE_TIME)
  plannedAmount  Decimal      @db.Decimal(14, 2) // how much you plan to spend per cycle, after adjustments
  // What plannedAmount was when the current cycle opened. Frozen per cycle so a
  // mid-cycle top-up or cut shows as a movement instead of rewriting history.
  cycleOpeningPlanned Decimal @default(0) @db.Decimal(14, 2)

  // RECURRING only: "every <interval> <unit>".
  recurrenceUnit     RecurrenceUnit?
  recurrenceInterval Int             @default(1)
  currency       String       @default("ETB")
  icon           String?
  color          String?
  note           String?
  alertThreshold Int          @default(80) // % of the funded pot - notify when crossed
  state          BudgetState  @default(ACTIVE)
  closedAt       DateTime?

  // Recurring bookkeeping. cycleIndex is the current phase; completed phases
  // are snapshotted into BudgetCycle and leftover money carries forward.
  // startsAt is chosen by the user - a plan is not spendable before it.
  cycleIndex     Int      @default(0)
  startsAt       DateTime @default(now())
  cycleStartedAt DateTime @default(now())
  nextResetAt    DateTime? // RECURRING only
  endDate        DateTime? // stop recurring after this

  allocations   BudgetAllocation[]
  adjustments   BudgetAdjustment[]
  cycles        BudgetCycle[]
  transactions  Transaction[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, state])
  @@index([userId, kind, nextResetAt])
  @@map("budgets")
}

// One fill-up (or give-back) of a plan's pot from a specific account.
model BudgetAllocation {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId   String
  budget     Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind       BudgetAllocationKind @default(FUND)
  amount     Decimal              @db.Decimal(14, 2) // signed: FUND > 0, RELEASE < 0
  cycleIndex Int                  @default(0)
  date       DateTime             @default(now())
  note       String?

  createdAt DateTime @default(now())

  @@index([budgetId, cycleIndex])
  @@index([userId, accountId])
  @@map("budget_allocations")
}

// A raise or a cut to a plan's amount, kept as a movement rather than an edit.
// Editing plannedAmount in place would silently rewrite what past cycles were
// meant to hold; this records the delta against the cycle it happened in.
model BudgetAdjustment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2) // signed: raise > 0, cut < 0
  cycleIndex Int      @default(0)
  reason     String?
  date       DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([budgetId, cycleIndex])
  @@map("budget_adjustments")
}

// Frozen record of a finished cycle of a recurring plan.
model BudgetCycle {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  index    Int

  startedAt DateTime
  endedAt   DateTime
  label     String

  // What the plan was set to when this cycle opened, and the net of any raises
  // or cuts made during it. plannedAmount is the closing figure of the two.
  openingPlanned Decimal @default(0) @db.Decimal(14, 2)
  adjustedAmount Decimal @default(0) @db.Decimal(14, 2)
  plannedAmount Decimal @db.Decimal(14, 2)
  carriedIn     Decimal @db.Decimal(14, 2) // pot balance when the cycle opened
  fundedAmount  Decimal @db.Decimal(14, 2) // carriedIn + fills during the cycle
  spentAmount   Decimal @db.Decimal(14, 2)
  leftoverAmount Decimal @db.Decimal(14, 2) // rolled into the next cycle
  txCount       Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([budgetId, index])
  @@map("budget_cycles")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  link      String?
  readFlag  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, readFlag])
  @@map("notifications")
}

// Per-user AI provider configuration. `providers` is an ordered JSON array
// (priority order) of { id, model, enabled, keyEnc }. API keys are encrypted
// at rest (AES-256-GCM) and never returned to the client.
model AiSetting {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providers Json     @default("[]")
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

model LedgerEntry {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         LedgerKind
  counterparty String // person or org name
  title        String? // optional label, e.g. "Freelance invoice #12"
  totalAmount  Decimal       @db.Decimal(14, 2)
  currency     String        @default("ETB")
  dueDate      DateTime?
  note         String?
  status       LedgerStatus  @default(OPEN)
  settledAt    DateTime?
  categoryId   String? // income category hint for EXPECTED_IN / repayments
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  payments LedgerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, kind])
  @@map("ledger_entries")
}

model LedgerPayment {
  id            String      @id @default(cuid())
  ledgerEntryId String
  ledgerEntry   LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(14, 2)
  date          DateTime    @default(now())
  note          String?
  transactionId String? // linked account transaction, if recorded

  createdAt DateTime @default(now())

  @@index([ledgerEntryId])
  @@map("ledger_payments")
}

// Creative wishlist - just the idea of a thing you want. No money lives here:
// a want holds no cost and no savings. When you are ready to act on one you
// "plan" it, which creates a Budget and links the two.
model WishlistItem {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  priority Int            @default(3) // 1 = dream-now, 5 = someday
  status   WishlistStatus @default(WANTING)
  note     String?
  link     String?
  emoji    String?

  // The plan created from this want, if it has been planned.
  budgetId String?
  budget   Budget?   @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  plannedAt DateTime?
  boughtAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([budgetId])
  @@map("wishlist_items")
}

// A frozen record of one week's money, taken at the Sunday-midnight boundary.
// Only the current and previous week are kept per user: this is a comparison
// aid, not an archive, and older weeks are always derivable from transactions.
model WeekSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime // Sunday 00:00 UTC
  weekEnd   DateTime // the following Sunday 00:00 UTC
  currency  String

  income        Decimal @db.Decimal(14, 2)
  expense       Decimal @db.Decimal(14, 2)
  net           Decimal @db.Decimal(14, 2)
  avgDailySpend Decimal @db.Decimal(14, 2)
  txCount       Int     @default(0)
  // Biggest spending category that week, for the comparison blurb.
  topCategory       String?
  topCategoryAmount Decimal? @db.Decimal(14, 2)

  // False while the week is still running, true once it has closed.
  sealed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency, weekStart])
  @@index([userId, weekStart])
  @@map("week_snapshots")
}

// A paired phone. The companion app authenticates SMS uploads with a long-lived
// device token instead of a 15-minute JWT, because the Android upload worker
// runs with no UI attached and cannot walk a refresh flow. Only the SHA-256 of
// the token is stored; the plaintext is shown to the user exactly once.
model Device {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // "Pixel 8"
  platform  String @default("android")
  tokenHash String @unique

  // Rough client fingerprint, purely for the "is my phone still forwarding?"
  // panel in settings.
  appVersion   String?
  lastSeenAt   DateTime?
  lastIngestAt DateTime?
  messageCount Int       @default(0)

  revokedAt DateTime?

  inboxMessages InboxMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@map("devices")
}

// Which SMS senders count as a bank, and what to do with their messages. The
// phone holds a copy of this list so non-matching messages never leave the
// device; the server copy is the source of truth the app syncs from.
model BankSenderRule {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which parser handles this sender - a key from the parser registry.
  bankKey String
  // The literal SMS originating address, e.g. "CBE" or "127".
  sender  String

  // Which wallet these messages land in. Null means the user still has to pick
  // an account when confirming.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Default category applied to parsed expenses from this sender.
  defaultCategoryId String?

  enabled Boolean @default(true)
  // Skip the review step and write the transaction straight away. Off by
  // default: a mis-parse that auto-posts is expensive to unpick once budget
  // reservations have moved.
  autoCommit Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sender])
  @@index([userId, enabled])
  @@map("bank_sender_rules")
}

// One captured bank message and whatever the parser made of it. Raw text is
// kept so a parser fix can re-run over history.
model InboxMessage {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String?
  device   Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  source   MessageSource @default(SMS)

  sender     String
  body       String
  receivedAt DateTime

  // SHA-256 over user + sender + body + the minute the message arrived. The
  // unique index on it is what makes re-uploading a batch harmless, which the
  // phone relies on: it retries until the server acknowledges.
  fingerprint String

  status InboxStatus @default(PENDING)

  // --- parse output -------------------------------------------------------
  bankKey        String?
  parsedKind     TxKind?
  parsedAmount   Decimal? @db.Decimal(14, 2)
  parsedCurrency String?
  // Balance the bank reported after the movement. Not written anywhere yet -
  // shown during review so a drifted account balance is obvious.
  parsedBalance  Decimal? @db.Decimal(14, 2)
  parsedPayee    String?
  // Bank's own receipt/reference number. The strongest dedupe key there is:
  // the same transaction arriving twice (SMS + email, or a resend) carries it.
  parsedRef      String?

  // PLAIN | ATM_WITHDRAWAL | ACCOUNT_TRANSFER. Anything other than PLAIN needs
  // a destination wallet the parser cannot know, so it always reaches review.
  movement       String   @default("PLAIN")
  // Masked account number of the other side, matched against Account.accountNumber.
  counterpartyAccount String?
  atmLocation    String?
  // Timestamp read out of the message body. Differs from receivedAt when the
  // SMS was delayed by the network, which is common enough to matter for
  // which day a transaction lands on.
  occurredAt     DateTime?
  // 0-100. Below the auto-commit floor a message always waits for review.
  confidence     Int      @default(0)

  // --- resolution ---------------------------------------------------------
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?
  // Why an auto-commit did not go through (e.g. the overdraw guard refused it).
  error         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, fingerprint])
  @@index([userId, status, receivedAt])
  @@index([userId, parsedRef])
  @@map("inbox_messages")
}

// User-defined conversion rates (e.g. 1 USD = 56.5 ETB). Never merge currencies without these.
model ExchangeRate {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency String // ISO 4217
  toCurrency   String
  rate         Decimal @db.Decimal(18, 8) // multiply: amount * rate = converted

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, fromCurrency, toCurrency])
  @@index([userId])
  @@map("exchange_rates")
}
