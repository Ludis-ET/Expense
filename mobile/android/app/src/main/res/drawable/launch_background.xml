<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS shows while the process starts. Matches the app's
     background token and centres the brand mark, so the Flutter splash picks
     up exactly where this leaves off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/santim_background" />
    <item
        android:drawable="@drawable/santim_mark"
        android:gravity="center" />
</layer-list>
