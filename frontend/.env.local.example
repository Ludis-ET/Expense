# URL of the backend API (used by next.config.ts rewrites in dev)
BACKEND_URL=http://localhost:4000

# --- Android app download -----------------------------------------------------
# The APK is not on Google Play (Google restricts SMS access to a short list of
# approved app types, and expense trackers are not on it), so the site serves it
# directly. Either drop the file at `frontend/public/downloads/santim.apk` and
# leave this unset, or point it at wherever you host the build.
# NEXT_PUBLIC_ANDROID_APP_URL=https://downloads.example.com/santim-1.0.0.apk

# Shown next to the download button.
# NEXT_PUBLIC_ANDROID_APP_VERSION=1.0.0
# NEXT_PUBLIC_ANDROID_APP_SIZE=28 MB
